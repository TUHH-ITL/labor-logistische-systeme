# Diese Datei nach ".env" kopieren und anpassen.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# ROS_DOMAIN_ID
# ---------------------------------------------------------------------------
# Trennt die ROS-Netze der Gruppen voneinander. Ohne unterschiedliche IDs
# sehen im Labor alle Gruppen die Topics aller anderen Gruppen, und die
# Roboter reagieren auf fremde Befehle.
#
# Feste Zuordnung im Seminar:
#   Gruppe 1 (Kommissionieren) -> 21
#   Gruppe 2 (Sortieren)       -> 22
#   Gruppe 3 (Inventur)        -> 23
#   Übungen ohne Roboter       -> 30 + eigene Zahl
#
# Erlaubt sind Werte von 0 bis 101.
ROS_DOMAIN_ID=30

# ---------------------------------------------------------------------------
# IMAGE_TAG
# ---------------------------------------------------------------------------
#   jazzy-base      Standard, ROS 2 mit Nav2, SLAM und AprilTags (ca. 5 GB)
#   jazzy-sim       zusätzlich Gazebo Harmonic (ca. 10 GB)
#   jazzy-vnc       wie jazzy-base, zusätzlich Linux-Desktop im Browser
#                   (noVNC), für macOS statt XQuartz, siehe
#                   docs/03-setup-macos.md
#   jazzy-vnc-sim   wie jazzy-vnc, zusätzlich Gazebo Harmonic
IMAGE_TAG=jazzy-base

# ---------------------------------------------------------------------------
# GPU_ADAPTER, nur Windows/WSL
# ---------------------------------------------------------------------------
# Notebooks haben oft zwei Grafikkarten, eine sparsame integrierte und eine
# schnelle dedizierte. WSL nimmt sonst die integrierte, was Gazebo spürbar
# langsamer macht. Tragt hier einen Teil des Namens eurer dedizierten Karte
# ein, die Groß- und Kleinschreibung ist egal.
#
#   NVIDIA   für GeForce und Quadro
#   AMD      für Radeon
#   Intel    integrierte Intel-Grafik, meist die langsamere Wahl
#
# Leer lassen, wenn es nur eine Grafikkarte gibt. Unter Linux und macOS hat
# die Einstellung keine Wirkung. Welche Karte tatsächlich benutzt wird, zeigt
# im Container "glxinfo -B".
GPU_ADAPTER=NVIDIA

# ---------------------------------------------------------------------------
# Software-Rendering
# ---------------------------------------------------------------------------
# Auf 1 setzen, falls RViz oder Gazebo mit einem OpenGL-Fehler abstürzen.
# Läuft dann langsamer, aber überhaupt.
LIBGL_ALWAYS_SOFTWARE=0
