# Diese Datei nach ".env" kopieren und anpassen.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# ROS_DOMAIN_ID
# ---------------------------------------------------------------------------
# Trennt die ROS-Netze der Gruppen voneinander. Ohne unterschiedliche IDs
# sehen im Labor alle Gruppen die Topics aller anderen Gruppen, und die
# Roboter reagieren auf fremde Befehle.
#
# Feste Zuordnung im Seminar:
#   Gruppe 1 (Kommissionieren) -> 21
#   Gruppe 2 (Sortieren)       -> 22
#   Gruppe 3 (Inventur)        -> 23
#   Übungen ohne Roboter       -> 30 + eigene Zahl
#
# Erlaubt sind Werte von 0 bis 101.
ROS_DOMAIN_ID=30

# ---------------------------------------------------------------------------
# IMAGE_TAG
# ---------------------------------------------------------------------------
#   jazzy-base  Standard, ROS 2 mit Nav2, SLAM und AprilTags (ca. 5 GB)
#   jazzy-sim   zusätzlich Gazebo Harmonic (ca. 10 GB)
IMAGE_TAG=jazzy-base

# ---------------------------------------------------------------------------
# Software-Rendering
# ---------------------------------------------------------------------------
# Auf 1 setzen, falls RViz oder Gazebo mit einem OpenGL-Fehler abstürzen.
# Läuft dann langsamer, aber überhaupt.
LIBGL_ALWAYS_SOFTWARE=0
