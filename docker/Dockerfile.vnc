# noVNC-Variante, ergänzt Basis- oder Simulations-Image um einen kompletten
# Linux-Desktop, der im Browser läuft. Für macOS gedacht, wo natives X11 über
# XQuartz bei OpenGL-Programmen wie RViz unzuverlässig ist, siehe
# docs/03-setup-macos.md.
#
# Wird von der CI zweimal gebaut:
#   BASE_IMAGE=jazzy-base -> Tag jazzy-vnc      (ohne Gazebo)
#   BASE_IMAGE=jazzy-sim  -> Tag jazzy-vnc-sim  (mit Gazebo)

ARG BASE_IMAGE=ghcr.io/tuhh-itl/labor-logistische-systeme:jazzy-base
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
      tigervnc-standalone-server \
      tigervnc-common \
      xfce4 \
      xfce4-terminal \
      dbus-x11 \
      novnc \
      websockify \
 && rm -rf /var/lib/apt/lists/*

# Eigene Displaynummer für die virtuelle Desktop-Sitzung, unabhängig vom
# DISPLAY, das docker-compose für natives X11 auf Linux/WSLg setzt.
ENV DISPLAY=:1
RUN echo 'export DISPLAY=:1' >> /home/ubuntu/.bashrc

# Das Ubuntu-Paket novnc liefert vnc.html, aber keine index.html. Ohne diesen
# Verweis zeigt der Browser unter http://localhost:6080 nur eine Dateiliste
# statt des Desktops.
RUN ln -sf vnc.html /usr/share/novnc/index.html

COPY --chown=ubuntu:ubuntu docker/vnc-xstartup /home/ubuntu/.vnc/xstartup
COPY docker/vnc-entrypoint.sh /usr/local/bin/vnc-entrypoint.sh
RUN chmod +x /home/ubuntu/.vnc/xstartup /usr/local/bin/vnc-entrypoint.sh

USER ubuntu
WORKDIR /home/ubuntu/ws
EXPOSE 6080

ENTRYPOINT ["/usr/local/bin/vnc-entrypoint.sh"]
CMD ["bash"]
